# Database Configuration - Per Service Databases
# Routing Service Database
ROUTING_DB_HOST=routing-db
ROUTING_DB_PORT=5432
ROUTING_DB_USER=routing_user
ROUTING_DB_PASSWORD=routing_pass
ROUTING_DB_NAME=routing_db

# VTC Service Database
VTC_DB_HOST=vtc-db
VTC_DB_PORT=5432
VTC_DB_USER=vtc_user
VTC_DB_PASSWORD=vtc_pass
VTC_DB_NAME=vtc_db

# Data Service Database
DATA_DB_HOST=data-db
DATA_DB_PORT=5432
DATA_DB_USER=data_user
DATA_DB_PASSWORD=data_pass
DATA_DB_NAME=data_db

# Legacy Database Configuration (for backward compatibility)
DB_HOST=postgres
DB_PORT=5432
DB_USER=axe_user
DB_PASSWORD=axe_password
DB_NAME=axe_db

# Service Ports
ROUTING_SERVICE_PORT=3001
VTC_SERVICE_PORT=8080
DATA_API_PORT=8000

# External Services
OSRM_URL=https://osrm.walidbechar.dev

# Application Environment
GIN_MODE=release
LOG_LEVEL=info

# Security (Change in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
POSTGRES_PASSWORD=axe_password

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Feature Flags
ENABLE_REAL_TIME=false
ENABLE_CACHING=false
CACHE_TTL=300
